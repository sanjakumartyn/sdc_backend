# Django Environment Variables Template

# Application Configurations
DEBUG=True
SECRET_KEY=django-insecure-your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Database Configurations
# Default uses MongoDB. For PostgreSQL/MySQL or SQLite, provide a matching URI:
# DATABASE_URL=mongodb://localhost:27017/sdc_backend
# DATABASE_URL=postgres://user:password@localhost:5432/dbname
DATABASE_URL=mongodb://localhost:27017/sdc_backend

# Agent/RAG microservice
AGENT_MICROSERVICE_BASE_URL=http://localhost:8001
AGENT_MICROSERVICE_QUESTION_PATH=/question
AGENT_MICROSERVICE_TIMEOUT=30

# Security: no JWT configuration required (auth removed)
