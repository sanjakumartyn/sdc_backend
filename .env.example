# Django Environment Variables Template

# Application Configurations
DEBUG=True
SECRET_KEY=django-insecure-your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Database Configurations
# Default uses MongoDB. For PostgreSQL/MySQL or SQLite, provide a matching URI:
# DATABASE_URL=mongodb://localhost:27017/sdc_backend
# DATABASE_URL=postgres://user:password@localhost:5432/dbname
DATABASE_URL=mongodb://localhost:27017/sdc_backend
# Alternatively, set Mongo values separately:
# MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?appName=Cluster0
# MONGO_DB_NAME=sdc_backend

# Agent/RAG microservices
AGENT_MICROSERVICE_BASE_URL=http://127.0.0.1:8000
AGENT_MICROSERVICE_QUESTION_PATH=/
AGENT_MICROSERVICE_TIMEOUT=60

PRODUCT_RAG_MICROSERVICE_BASE_URL=http://127.0.0.1:8001
PRODUCT_RAG_MICROSERVICE_QUESTION_PATH=/api/products/find
PRODUCT_RAG_MICROSERVICE_TIMEOUT=30
PRODUCT_RAG_PROJECT_ID=product
PRODUCT_RAG_PROJECT_KEY=product
PRODUCT_RAG_FILTER_TAG=MY_Company_product_Studies

CASE_STUDY_RAG_ENABLED=false
CASE_STUDY_RAG_MICROSERVICE_BASE_URL=
CASE_STUDY_RAG_MICROSERVICE_QUESTION_PATH=
CASE_STUDY_RAG_MICROSERVICE_TIMEOUT=30
CASE_STUDY_RAG_PROJECT_ID=casestudy
CASE_STUDY_RAG_PROJECT_KEY=casestudy
CASE_STUDY_RAG_FILTER_TAG=MY_Company_product_Studies

OCR_MICROSERVICE_BASE_URL=http://127.0.0.1:8003
OCR_EXTRACT_DOCUMENTS_PATH=/extract/documents
OCR_MICROSERVICE_TIMEOUT=60

COMPANY_ANALYSIS_DATA_LIMIT_PER_COLLECTION=10
COMPANY_ANALYSIS_DEAL_LIMIT=10
COMPANY_ANALYSIS_DEBUG=false

LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
GEMINI_TIMEOUT=60
GEMINI_FALLBACK_TO_GROQ=true

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT=30
GROQ_KEYWORD_LIMIT=8

# Security: no JWT configuration required (auth removed)
